PickRewardQtyButton < UIButton
  size: 16 16
  image-source: /game_rewardwall/images/buttons_pick_rewards
  image-size: 16 16
  image-auto-resize: false
  focusable: false

PickRewardQtyButtonBackAll < PickRewardQtyButton
  image-clip: 0 32 16 16
  $disabled:
    image-clip: 0 0 16 16
  $hover !disabled:
    image-clip: 0 32 16 16
  $pressed:
    image-clip: 0 64 16 16

PickRewardQtyButtonBackOne < PickRewardQtyButton
  image-clip: 0 48 16 16
  $disabled:
    image-clip: 0 16 16 16
  $hover !disabled:
    image-clip: 0 48 16 16
  $pressed:
    image-clip: 0 80 16 16

PickRewardQtyButtonForwardOne < PickRewardQtyButton
  image-clip: 16 48 16 16
  $disabled:
    image-clip: 16 16 16 16
  $hover !disabled:
    image-clip: 16 48 16 16
  $pressed:
    image-clip: 16 80 16 16

PickRewardQtyButtonForwardAll < PickRewardQtyButton
  image-clip: 16 32 16 16
  $disabled:
    image-clip: 16 0 16 16
  $hover !disabled:
    image-clip: 16 32 16 16
  $pressed:
    image-clip: 16 64 16 16

ItemReward < UIWidget
  padding-top: 4
  padding-bottom: 4
  padding-left: 8
  padding-right: 8
  height: 36

  Item
    id: item
    size: 34 34
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: -3
    margin-left: -7
    text-align: center
    phantom: true
    virtual: true

  Label
    id: title
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: prev.right
    text-align: left
    width: 160
    margin-top: 1
    margin-left: 5
    font: $var-cip-font-new
    color: #c0c0c0

  UIWidget
    id: quantity
    size: 104 16
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: prev.right
    margin-left: 27

    PickRewardQtyButtonBackAll
      id: btnMin
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      @onClick: modules.game_rewardwall.onPickRewardQtyClick(self, 'min')

    PickRewardQtyButtonBackOne
      id: btnDec
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 3
      @onClick: modules.game_rewardwall.onPickRewardQtyClick(self, 'dec')

    UIWidget
      id: numberBox
      size: 24 16
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 3
      background-color: #2a2a2aff
      border-width-top: 1
      border-width-left: 1
      border-width-right: 1
      border-width-bottom: 1
      border-color-bottom: #808080
      border-color-right: #808080
      border-color-left: #131313
      border-color-top: #131313

      Label
        id: numberValue
        anchors.fill: parent
        font: $var-cip-font-new
        color: #c0c0c0
        text-align: center
        text: 0

    PickRewardQtyButtonForwardOne
      id: btnInc
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 3
      @onClick: modules.game_rewardwall.onPickRewardQtyClick(self, 'inc')

    PickRewardQtyButtonForwardAll
      id: btnMax
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 3
      @onClick: modules.game_rewardwall.onPickRewardQtyClick(self, 'max')

  Label
    id: weight
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    font: $var-cip-font-new
    color: #c0c0c0
    margin-top: 1
    margin-right: 6
    width: 81
    text-align: right
    text-auto-resize: true
    text: 0.00 oz

