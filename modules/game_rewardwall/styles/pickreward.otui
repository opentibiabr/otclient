MainWindowHigh
  !text: tr('Pick Reward')
  size: 450 378
  text-offset: 0 2
  font: $var-cip-font-new
  color: #909090
  @onEscape: modules.game_rewardwall.destroyPickReward()
  padding: 20

  Label
    id: rewardLabel
    font: $var-cip-font-new
    color: #c0c0c0
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 9
    margin-left: -5
    text: you have selected 0 of 2 reward items.

  TextList
    id: rewardList
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 5
    margin-left: -4
    size: 418 265
    fixed-size: true
    vertical-scrollbar: rewardListScrollBar
    background-color: #404040
    padding: 1
    border-width-top: 1
    border-width-left: 1
    border-width-right: 1
    border-width-bottom: 1
    border-color-bottom: #808080
    border-color-right: #808080
    border-color-left: #131313
    border-color-top: #131313

  VerticalQtScrollBar
    id: rewardListScrollBar
    anchors.top: rewardList.top
    anchors.bottom: rewardList.bottom
    anchors.right: rewardList.right
    step: 14
    margin-top: 1
    margin-right: 1
    margin-bottom: 1

  Panel
    id: capacity
    font: $var-cip-font-new
    color: #c0c0c0
    anchors.left: parent.left
    anchors.top: rewardList.bottom
    margin-top: 6
    margin-left: -11
    text: Free Capacity: 737.60 oz

  Label
    font: $var-cip-font-new
    color: #c0c0c0
    id: weight
    anchors.right: parent.right
    anchors.top: rewardList.bottom
    margin-top: 6
    margin-right: 5
    text: Total weight: 0.00 oz

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right 
    anchors.top: prev.bottom
    margin-top: 6
    margin-left: -4
    margin-right: -4

  Button
    id: btnClose
    !text: tr('Close')
    size: 43 20
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: -4
    margin-bottom: -4
    @onClick: modules.game_rewardwall.destroyPickReward(true)

  Button
    id: btnOk
    !text: tr('Ok')
    size: 43 20
    anchors.right: btnClose.left
    anchors.bottom: parent.bottom
    margin-right: 6
    margin-bottom: -4
    enabled: false
    @onClick: modules.game_rewardwall.onClickBtnOk()
