StatsBarUp < UIStatsBar
  StatsBarDarkBackground
    anchors.fill: parent
    phantom: true

  UIWidget
    id: bar
    width: 1
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin: 1
    image-repeated: true

  StatsHorizontalBarGrade
    id: horizontalGrade
    anchors.fill: parent
    visible: false

  Label
    id: text
    anchors.verticalCenter: parent.verticalCenter
    anchors.horizontalCenter: parent.horizontalCenter
    text-align: center
    visible: false
    !text: '9999999999/9999999999'

StatsBarTopWithShrink < UIWidget
  UIWidget
    anchors.fill: parent
    image-source: /images/ui/background
    image-repeated: true

  UIWidget
    anchors.right: rightIncreaseSidePanels.left
    anchors.left: leftIncreaseSidePanels.right
    anchors.top: parent.top
    height: 2
    background-color: white
    opacity: 0.35

  UIWidget
    anchors.right: rightIncreaseSidePanels.left
    anchors.top: parent.top
    anchors.bottom: rightDecreaseSidePanels.bottom
    margin-bottom: -2
    margin-top: 2
    width: 2
    background-color: black
    opacity: 0.35

  UIWidget
    anchors.right: parent.right
    anchors.left: prev.left
    anchors.top: rightDecreaseSidePanels.bottom
    height: 2
    background-color: white
    opacity: 0.35

  UIWidget
    anchors.right: parent.right
    anchors.top: prev.bottom
    anchors.bottom: parent.bottom
    width: 2
    background-color: black
    opacity: 0.35

  UIWidget
    anchors.right: parent.right
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 2
    margin-right: 2
    height: 2
    background-color: black
    opacity: 0.35

  UIWidget
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.top: leftDecreaseSidePanels.bottom
    width: 1
    background-color: white
    opacity: 0.35

  UIWidget
    anchors.left: parent.left
    anchors.top: leftDecreaseSidePanels.bottom
    anchors.right: leftDecreaseSidePanels.right
    margin-left: 1
    height: 1
    background-color: white
    opacity: 0.35

  UIWidget
    anchors.left: leftDecreaseSidePanels.right
    anchors.bottom: leftDecreaseSidePanels.bottom
    anchors.top: parent.top
    margin-top: 2
    width: 2
    background-color: black
    opacity: 0.35

  UIWidget
    id: leftIncreaseSidePanels
    anchors.left: parent.left
    anchors.top: parent.top
    size: 9 27

  UIWidget
    id: leftDecreaseSidePanels
    anchors.left: parent.left
    anchors.top: leftIncreaseSidePanels.bottom
    size: 9 27

  UIWidget
    id: rightIncreaseSidePanels
    anchors.right: parent.right
    anchors.top: parent.top
    size: 9 27

  UIWidget
    id: rightDecreaseSidePanels
    anchors.right: parent.right
    anchors.top: rightIncreaseSidePanels.bottom
    size: 9 27

TopStatsSkillElement < UIWidget
  height: 20

  Label
    id: level
    !text: '99999'
    color: #c0c0c0ff
    text-align: right
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 7
    font: verdana-11px-monochrome
    
  UIWidget
    id: icon
    size: 9 9
    anchors.verticalCenter: level.verticalCenter
    anchors.left: level.right
    margin-left: 5

  StatsBarUpTransparent
    id: bar
    anchors.verticalCenter: level.verticalCenter
    anchors.left: icon.right
    anchors.right: parent.right
    !statsbar-size: 'tiny'
    !statsbar-orientation: 'horizontal'
    statsbar-text: true
    margin-left: 5
    height: 5
  
  UIButton
    id: xpBoostBtn
    visible: false
    size: 76 14
    image-source: /images/ui/button-storexp-noborder-idle
    anchors.verticalCenter: level.verticalCenter
    margin-left: 2
    cursor: pointinghand
    @onClick: |
      if modules.game_store and modules.game_store.toggle then
        modules.game_store.toggle()
        g_game.sendRequestStorePremiumBoost()
      end
    $pressed:
      size: 76 14
      image-source: /images/ui/button-storexp-pressed

HarmonyIcon < UIWidget
  size: 13 13
  !tooltip: 'Harmoney'
  image-source: /images/game/vocations/monk/icon-combopoint-empty
  $on:
    image-source: /images/game/vocations/monk/icon-combopoint-filled

MonkStats < UIWidget
  id: monkStats
  enabled: false
  $disabled:
    visible: false
    margin-left: 0
    margin-top: 0
    size: 0 0
  $!disabled:
    visible: true
    margin-left: 7
    width: 103

  Panel
    id: harmonies
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: -1
    padding: 2
    size: 80 18
    layout:
      type: horizontalBox
      spacing: 3
    HarmonyIcon
    HarmonyIcon
    HarmonyIcon
    HarmonyIcon
    HarmonyIcon

  VerticalSeparator
    id: separatorHarmoniesSerene
    anchors.left: harmonies.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 5
    margin-top: 2
    margin-bottom: 2
    width: 2

  UIWidget
    id: serene
    anchors.left: separatorHarmoniesSerene.right
    anchors.top: parent.top
    margin-left: 3
    margin-top: 1
    size: 13 13
    !tooltip: 'Serene'
    image-source: /images/game/vocations/monk/icon-serene-off
    $on:
      image-source: /images/game/vocations/monk/icon-serene-on
    @onSetup: self:setOn(true)
    $disabled:
      visible: false
      size: 0 0
    $!disabled:
      visible: true
      size: 13 13

TopStatsBarLargeOnTop < UIWidget
  StatsBarTopWithShrink
    anchors.fill: parent

  StatsBarUp
    id: health
    anchors.top: icons.top
    anchors.left: parent.left
    anchors.right: proficiencyIcon.left
    !statsbar-type: 'health'
    !statsbar-size: 'large'
    !statsbar-orientation: 'horizontal'
    statsbar-text: true
    margin-left: 12
    margin-right: 7
    height: 27

  Panel
    id: proficiencyIcon
    image-border: 3
    image-source: /images/ui/containerslot
    anchors.top: parent.top
    anchors.bottom: icons.bottom
    anchors.right: icons.left
    margin-top: 5
    margin-right: 5
    size: 28 28
    layout:
      type: anchor
    
    UIWidget
      id: highlightProficiencyButton
      size: 28 28
      anchors.top: proficiencyIcon.top
      anchors.left: proficiencyIcon.left
      visible: true
      phantom: true
      image-source: /images/game/topbar/highlight-proficiency-button

    UIProgressRect
      id: proficiencyProgress
      background-color: #1abc9c
      percent: 40
      percent-reverse: true
      phantom: true
      anchors.fill: parent
      margin: 2

    UIButton
      id: proficiencyButton
      image-source: /images/ui/button-grey-qt
      image-clip: 0 0 98 40
      image-border: 2
      !tooltip: 'Proficiency Tree'
      size: 20 20
      margin-left: 0
      anchors.centerIn: parent
      @onClick: |
        if modules.game_proficiency and modules.game_proficiency.toggle then
          modules.game_proficiency.toggle()
        end
      $pressed:
        image-clip: 0 40 98 40

      UIWidget
        id: proficiencyButtonIcon
        image-source: /images/game/topbar/icon-proficiencytree-open
        image-auto-resize: true
        phantom: true
        anchors.centerIn: parent

  Panel
    id: icons
    image-border: 3
    image-source: /images/ui/containerslot
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 5
    size: 52 27
    layout:
      type: horizontalBox

  MonkStats
    id: monkStats
    anchors.top: icons.top
    anchors.bottom: icons.bottom
    anchors.left: icons.right
    margin-top: 5

  StatsBarUp
    id: mana
    anchors.top: icons.top
    anchors.right: parent.right
    anchors.left: monkStats.right
    !statsbar-type: 'mana'
    !statsbar-size: 'large'
    !statsbar-orientation: 'horizontal'
    statsbar-text: true
    margin-right: 12
    margin-left: 7
    height: 27
    font: verdana-11px-monochrome
    font-size: 10

  StatsBarUp
    id: manashield
    anchors.top: mana.bottom
    anchors.right: parent.right
    anchors.left: monkStats.right
    !statsbar-type: 'manashield'
    !statsbar-size: 'large'
    !statsbar-orientation: 'horizontal'
    statsbar-text: true
    margin-top: 4
    margin-right: 12
    margin-left: 6
    height: 27
    font: verdana-11px-monochrome 
    font-size: 10

  Panel
    id: skills
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: manashield.bottom
    margin-top: 6
    margin-left: 12
    margin-right: 18
    height: 0

